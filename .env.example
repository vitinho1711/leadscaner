# Variáveis de Ambiente - Lead Scanner
# Copie este arquivo como .env e preencha os valores

# Supabase (opcional, para uso futuro)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq API (para IA/chat)
GROQ_API_KEY=

# JWT Secret (gere um valor aleatório e seguro)
JWT_SECRET=

# Servidor
NODE_ENV=production
PORT=3001

# Diretório de dados persistentes (para Docker)
DATA_DIR=/app/data
